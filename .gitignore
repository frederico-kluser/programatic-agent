# NO trailing slash: a trailing slash matches a DIRECTORY only, and every
# agent worktree in this repo's parallel-agent flow gets `node_modules` as a
# SYMLINK to the main checkout's. With `node_modules/` the symlink stayed
# untracked-and-unignored, so one `git add -A` would commit the author's
# absolute machine path into the branch. Bare `node_modules` matches both.
node_modules
dist/
*.log
.DS_Store
.huu-worktrees/
.huu/

# vitest json reporter output (posttest gate)
.vitest-report.json

# smoke-test scratch (scripts/smoke-*.sh no macOS)
.smoke-tmp/

# huu runtime cache (native shim compiled on host smoke runs)
.huu-cache/

# Local refactor fixtures (teste_1 / teste_2) — their own git repos
/projects/

.omo/

.claude/

.deep-orchestrator/
